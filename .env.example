# ============================================================
#  ProjectStruct — configuration de production (Docker)
#  Copier en `.env` :  cp .env.example .env
#  Secrets :  openssl rand -hex 48   (hex uni  quement, car DATABASE_PASSWORD
#  est injecté tel quel dans l'URL de connexion PostgreSQL)
# ============================================================

# ---------- Base de données ----------
# OBLIGATOIRE : mot de passe de PostgreSQL (utilisé par le conteneur db ET l'API).
# Ne doit contenir que [A-Za-z0-9] pour être sûr dans DATABASE_URL.
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT
DATABASE_NAME=toolbox

# ---------- JWT ----------
# OBLIGATOIRE : openssl rand -hex 48
JWT_SECRET=CHANGE_MOI_PAR_UN_SECRET_ALEATOIRE_LONG
JWT_EXPIRES_IN=1d

# ---------- Limitation de débit ----------
# Nombre de requêtes autorisées par minute et par IP sur l'API.
# 30 est la valeur par défaut de NestJS et trop bas en production.
RATE_LIMIT_PER_MINUTE=600

# ---------- Données de démo ----------
# false = uniquement les migrations Prisma au démarrage (recommandé en prod)
# true  = charge aussi les utilisateurs et le projet de démonstration
SEED_ON_START=false

# ---------- Frontend / réseau ----------
# URL publique du frontend (utilisée dans les emails de vérification)
FRONTEND_URL=http://91.134.139.163
# Origines CORS autorisées, séparées par des virgules.
# À laisser vide avec Nginx (same-origin). Remplir uniquement en cas d'accès
# depuis d'autres origines (ex. domaines séparés).
CORS_ORIGINS=
# Port HTTP du reverse proxy Nginx
HTTP_PORT=80

# ---------- Email (SMTP) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ProjectStruct <noreply@toolbox.com>
MAIL_SECURE=false

# ---------- IA (Groq) ----------
# Sans clé, les fonctionnalités d'IA (résumés, chatbot) ne fonctionneront pas.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Embeddings / RAG ----------
# local = @xenova/transformers embarqué (Xenova/all-MiniLM-L6-v2, 384 dims)
# api   = endpoint compatible OpenAI, renseignez EMBEDDINGS_API_URL
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDINGS_API_URL=
# ChromaDB est facultatif : sans ChromaDB, le service utilise un client mock
# et la recherche sémantique RAG est indisponible.
CHROMA_URL=
CHROMA_COLLECTION=project_summaries
RAG_DISTANCE_THRESHOLD=0.4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
