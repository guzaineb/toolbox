generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================
// ENUMS
// ===========================
enum UserRole {
  ADMIN
  EXPERT
  PROJECT_OWNER
  INCUBATOR_MEMBER // anciennement `incubator_membre` (valeur historique, migrée)
}

enum MemberRole {
  ADMIN
  PROGRAM_MANAGER
  COHORT_MANAGER
  REVIEW_MANAGER
  MEMBER
  VIEWER
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum IncubatorMemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncubatorStatus {
  ACTIVE
  SUSPENDED
}

enum Language {
  FR
  EN
  AR
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum CohortStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ParticipationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum FundingPhase {
  IDEATION
  VALIDATION
  EARLY_STAGE
  GROWTH
  SCALING
}

enum ImpactPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DocumentStatus {
  NOT_GENERATED
  GENERATED
  UPDATED
}

enum ParticipationOrigin {
  APPLICATION
  INVITATION
}

enum CohortExpertRole {
  JURY
  COACH
}

enum CohortExpertStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum CoachingSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  MISSED
}

enum CoachingActionStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  REJECTED
  OVERDUE
  CANCELLED
}

enum CoachingActionPriority {
  LOW
  MEDIUM
  HIGH
}

enum CoachingRecommendationStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum EvaluationStage {
  INTERMEDIATE
  FINAL
}

enum FinalDecisionType {
  ACCEPTED
  REJECTED
  CONDITIONAL
  EXTENDED
  REEVALUATION_REQUIRED
}

enum ConditionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum JurySessionStatus {
  DRAFT
  OPEN
  DELIBERATION
  CLOSED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceType {
  PROJECT
  COHORT
  INCUBATOR
  EVALUATION
  COACHING
  DOCUMENT
  USER
  INCUBATOR_MEMBER
}

enum NotificationType {
  // === EXISTANT (conservé pour compatibilité) ===
  APPLICATION_SUBMITTED
  INVITATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  INVITATION_ACCEPTED
  INVITATION_REJECTED

  // === INCUBATEUR ===
  MEMBER_JOINED
  MEMBER_LEFT
  COHORT_CREATED
  COHORT_UPDATED
  APPLICATION_OPEN
  DOCUMENT_VERIFIED

  // === PORTEUR DE PROJET ===
  NEW_EVALUATION
  NEW_COACHING // VALEUR ORPHELINE : référencée par les templates email backend, jamais créée en app
  COACHING_FEEDBACK
  DOCUMENT_GENERATED
  DOCUMENT_UPDATED
  AI_RESPONSE_READY
  STEP_COMPLETED

  // === EXPERT ===
  ASSIGNED_AS_COACH
  ASSIGNED_AS_JURY
  EVALUATION_REQUESTED
  COACHING_SCHEDULED
  PROJECT_MATCHED
  PROJECT_UNMATCHED

  // === COACHING & ÉVALUATION (module) ===
  COACHING_SESSION_SCHEDULED
  COACHING_SESSION_UPDATED
  COACHING_SESSION_CANCELLED
  COACHING_SESSION_COMPLETED
  COACHING_REPORT_SUBMITTED
  COACHING_ACTION_ASSIGNED
  COACHING_ACTION_UPDATED
  COACHING_ACTION_COMPLETED
  COACHING_ACTION_DEADLINE_SOON
  COACHING_ACTION_OVERDUE
  COACHING_RECOMMENDATION_ADDED
  COACHING_COMMENT_ADDED
  COACH_ASSIGNED
  COACH_REMOVED
  EVALUATION_AVAILABLE
  EVALUATION_SUBMITTED
  EVALUATION_ALL_COMPLETED
  EVALUATION_DEADLINE_SOON
  EVALUATION_TEMPLATE_CREATED
  FINAL_DECISION_MADE
  FINAL_DECISION_UPDATED
  FINAL_DECISION_CONDITIONS_ADDED
  CONDITION_VALIDATED
  REEVALUATION_REQUESTED

  // === ADMIN ===
  NEW_USER_REGISTERED
  NEW_INCUBATOR
  NEW_EXPERT
  USER_REPORTED
  CRITICAL_ERROR

  // === DOCUMENT ===
  DOCUMENT_PENDING
}

// ===========================
// IDENTITY — Users & Profiles
// ===========================
model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  password_hash             String
  is_active                 Boolean   @default(true)
  is_verified               Boolean   @default(false)
  verification_token        String?
  verification_code         String?
  verification_code_expires DateTime?
  last_login_at             DateTime?
  reset_password_token        String?
  reset_password_expires      DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  role                      UserRole?
  profile_id                String?   @unique

  profile              UserProfile?             @relation(fields: [profile_id], references: [id])
  projectOwnerProfile  ProjectOwnerProfile?
  expertProfile        ExpertProfile?
  incubatorMembers     IncubatorMember[]
  documents            IncubatorDocument[]
  cohortExperts        CohortExpert[]           @relation("ExpertUser")
  assignedCohorts      CohortExpert[]           @relation("AssignedBy")
  evaluations          Evaluation[]
  coachings            Coaching[]
  notifications        Notification[]        @relation("NotificationRecipient")
  sentNotifications    Notification[]        @relation("NotificationSender")
  notificationPreference NotificationPreference?

  // Coaching & Évaluation
  projectExpertAssignments        ProjectExpertAssignment[]  @relation("AssignmentExpert")
  assignedProjectExpertAssignments ProjectExpertAssignment[] @relation("AssignmentAssignedBy")
  coachingSessionsCreated         CoachingSession[]          @relation("SessionCreatedBy")
  coachingActionsCreated          CoachingAction[]           @relation("ActionCreatedBy")
  coachingRecommendations         CoachingRecommendation[]   @relation("RecommendationAuthor")
  coachingComments                CoachingComment[]          @relation("CommentAuthor")
  evaluationTemplatesCreated      EvaluationTemplate[]       @relation("TemplateCreatedBy")
  evaluationAssignmentsJury       EvaluationAssignment[]     @relation("EvaluationJury")
  evaluationAssignmentsCreated    EvaluationAssignment[]     @relation("EvaluationAssignedBy")
  finalDecisionsDecided           FinalDecision[]            @relation("DecisionDecidedBy")
  conditionValidated              FinalDecisionCondition[]   @relation("ConditionValidatedBy")
  jurySessionsCreated             JurySession[]              @relation("JuryCreatedBy")
  jurySessionMemberships          JurySessionMember[]        @relation("JuryMemberUser")
  auditLogs                       AuditLog[]                 @relation("AuditActor")

  @@map("users")
}

model UserProfile {
  id                 String   @id @default(uuid())
  first_name         String
  last_name          String
  phone              String?
  avatar_url         String?
  birth_date         DateTime?
  country            String?
  city               String?
  address            String?
  bio                String?
  preferred_language Language  @default(FR)
  linkedin           String?

  user User?

  @@map("user_profiles")
}

// ===========================
// EXPERT
// ===========================
model ExpertiseArea {
  id       String @id @default(uuid())
  name     String
  category String?

  expertiseConnections ExpertProfileExpertiseArea[]

  @@map("expertise_areas")
}

model ExpertProfile {
  id                  String             @id @default(uuid())
  headline            String
  bio                 String?
  organization        String?
  position            String?
  years_of_experience Int?
  linkedin_url        String?
  availability_status AvailabilityStatus @default(AVAILABLE)
  user_id             String             @unique

  user                 User                          @relation(fields: [user_id], references: [id])
  expertiseConnections ExpertProfileExpertiseArea[]

  @@map("expert_profiles")
}

model ExpertProfileExpertiseArea {
  id                  String   @id @default(uuid())
  level               String?
  years_of_experience Int?     @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  expert_profile_id String
  expertise_area_id String

  expertProfile  ExpertProfile  @relation(fields: [expert_profile_id], references: [id], onDelete: Cascade)
  expertiseArea  ExpertiseArea  @relation(fields: [expertise_area_id], references: [id], onDelete: Cascade)

  @@unique([expert_profile_id, expertise_area_id])
  @@map("expert_profile_expertise_areas")
}

// ===========================
// INCUBATORS
// ===========================
model Incubator {
  id                  String            @id @default(uuid())
  name                String
  legal_name          String?
  slug                String            @unique
  description         String?
  foundation_date     DateTime?
  organization_type   String?
  registration_number String?
  tax_id              String?
  email               String?
  phone               String?
  website_url         String?
  address             String?
  country             String?
  city                String?
  logo_url            String?
  verification_status VerificationStatus @default(PENDING)
  status              IncubatorStatus    @default(ACTIVE)
  created_by_user_id  String
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  members     IncubatorMember[]
  documents   IncubatorDocument[]
  invitations IncubatorInvitation[]
  cohorts     Cohort[]

  @@map("incubators")
}

model IncubatorMember {
  id                  String               @id @default(uuid())
  user_id             String
  incubator_id        String
  role                MemberRole           @default(MEMBER)
  job_title           String?
  department          String?
  bio                 String?
  status              IncubatorMemberStatus @default(ACTIVE)
  is_primary_contact  Boolean              @default(false)
  can_manage_programs Boolean              @default(false)
  can_manage_cohorts  Boolean              @default(false)
  can_manage_members  Boolean              @default(false)

  user      User      @relation(fields: [user_id], references: [id])
  incubator Incubator @relation(fields: [incubator_id], references: [id])

  @@unique([user_id, incubator_id])
  @@map("incubator_members")
}

model IncubatorInvitation {
  id           String     @id @default(uuid())
  token        String     @unique
  incubator_id String
  email        String
  role         MemberRole
  job_title    String?
  expires_at   DateTime
  created_at   DateTime   @default(now())

  incubator Incubator @relation(fields: [incubator_id], references: [id])

  @@map("incubator_invitations")
}

model IncubatorDocument {
  id                  String             @id @default(uuid())
  incubator_id        String
  document_type       String
  file_url            String
  verification_status VerificationStatus @default(PENDING)
  rejection_reason    String?
  uploaded_by_user_id String
  uploaded_at         DateTime           @default(now())

  incubator       Incubator @relation(fields: [incubator_id], references: [id])
  uploaded_by_user User     @relation(fields: [uploaded_by_user_id], references: [id])

  @@index([incubator_id])
  @@index([uploaded_by_user_id])
  @@map("incubator_documents")
}

// ===========================
// PROJECT OWNER
// ===========================
model ProjectOwnerProfile {
  id                              String   @id @default(uuid())
  current_status                  String?
  education_level                 String?
  field_of_study                  String?
  occupation                      String?
  linkedin_url                    String?
  entrepreneurial_experience_level Int      @default(0)
  has_previous_startup            Boolean  @default(false)
  user_id                         String   @unique
  created_at                      DateTime @default(now())
  updated_at                      DateTime @updatedAt

  user        User                     @relation(fields: [user_id], references: [id])
  skills      ProjectOwnerSkill[]
  experiences ProjectOwnerExperience[]

  @@map("project_owner_profiles")
}

model ProjectOwnerSkill {
  id                       String   @id @default(uuid())
  skill_name               String
  level                    String?
  project_owner_profile_id String
  created_at               DateTime @default(now())

  profile ProjectOwnerProfile @relation(fields: [project_owner_profile_id], references: [id], onDelete: Cascade)

  @@index([project_owner_profile_id])
  @@map("project_owner_skills")
}

model ProjectOwnerExperience {
  id                       String   @id @default(uuid())
  title                    String
  organization             String
  description              String?
  start_date               DateTime?
  end_date                 DateTime?
  project_owner_profile_id String
  created_at               DateTime @default(now())

  profile ProjectOwnerProfile @relation(fields: [project_owner_profile_id], references: [id], onDelete: Cascade)

  @@index([project_owner_profile_id])
  @@map("project_owner_experiences")
}

// ===========================
// CORE — Projects
// ===========================
model Project {
  id              String   @id @default(uuid())
  name            String
  description     String?
  owner_id        String
  gbm_reviewed_at DateTime?
  is_gbm_reviewed Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Phase 1
  idea_sketch              IdeaSketch?
  problems_needs           ProblemsNeeds?
  pestel                   Pestel?
  objective                Objective?
  mission_vision           MissionVision?
  context_summary          ContextSummary?

  // Phase 2
  stakeholder              Stakeholder[]
  stakeholder_map          StakeholderMap[]
  customer_segment         CustomerSegment[]
  value_proposition        ValueProposition?
  test_discovery           TestDiscovery[]
  value_proposition_pivot  ValuePropositionPivot?
  customer_relations_channel CustomerRelationsChannel?
  customer_journey         CustomerJourney[]
  key_activities_resource  KeyActivitiesResource?
  eco_design               EcoDesign?
  eco_design_result        EcoDesignResult?
  summary_activity         SummaryActivity?
  cost_structure           CostStructure?
  revenue_stream           RevenueStream?
  cost_revenue_summary     CostRevenueSummary?

  // Phase 3
  test_preparation         TestPreparation?

  // Phase 4
  indicator                Indicator?

  // Business Plan
  management_plan          ManagementPlan?
  marketing_plan           MarketingPlan?
  financial_plan           FinancialPlan?
  legal_plan               LegalPlan?
  kpi                      Kpi?
  executive_summary        ExecutiveSummary?

  // Modules transverses
  funding_assessment       FundingAssessment?
  market_access            MarketAccess?
  impact_measure           ImpactMeasure?

  // Analyse SWOT
  swot_analysis            SwotAnalysis?

  // Documents générés
  generated_documents      GeneratedDocument[]

  // Relations
  step_progresses        StepProgress[]
  ai_interactions        AiInteraction[]
  cohort_participations  CohortParticipation[]
  evaluations            Evaluation[]
  coachings              Coaching[]

  // Coaching & Évaluation
  projectExpertAssignments ProjectExpertAssignment[]
  coachingActions          CoachingAction[]
  coachingRecommendations  CoachingRecommendation[]
  evaluationAssignments    EvaluationAssignment[]
  finalDecisions           FinalDecision[]
  jurySessions             JurySession[]

  @@index([name])
  @@index([owner_id])
  @@map("projects")
}

// ===========================
// CORE — Step Progress
// ===========================
model StepProgress {
  id           String     @id @default(uuid())
  project_id   String
  step_key     String
  status       StepStatus @default(NOT_STARTED)
  completed_at DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, step_key])
  @@index([project_id])
  @@index([step_key])
  @@index([status])
  @@map("step_progress")
}

// ===========================
// CORE — Cohorts
// ===========================
model Cohort {
  id                   String        @id @default(uuid())
  name                 String
  program              String?
  description          String?
  capacity             Int?
  current_participants Int           @default(0)
  application_deadline DateTime?
  start_date           DateTime?
  end_date             DateTime?
  status               CohortStatus  @default(DRAFT)
  incubator_id         String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  incubator      Incubator?          @relation(fields: [incubator_id], references: [id])
  participations CohortParticipation[]
  experts        CohortExpert[]

  // Coaching & Évaluation
  evaluationAssignments EvaluationAssignment[]
  evaluationTemplates   EvaluationTemplate[]
  finalDecisions        FinalDecision[]
  jurySessions          JurySession[]

  @@index([status])
  @@index([incubator_id])
  @@map("cohorts")
}

model CohortParticipation {
  id           String              @id @default(uuid())
  cohort_id    String
  project_id   String
  status       ParticipationStatus @default(PENDING)
  origin       ParticipationOrigin @default(APPLICATION)
  applied_at   DateTime            @default(now())
  invited_at   DateTime?
  responded_at DateTime?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  cohort  Cohort  @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([cohort_id, project_id])
  @@index([cohort_id])
  @@index([project_id])
  @@index([status])
  @@map("cohort_participations")
}

// ===========================
// CORE — Cohort Experts
// ===========================
model CohortExpert {
  id              String            @id @default(uuid())
  cohort_id       String
  expert_user_id  String
  role            CohortExpertRole
  status          CohortExpertStatus @default(PENDING)
  assigned_by     String
  assigned_at     DateTime          @default(now())
  invited_at      DateTime?
  responded_at    DateTime?

  cohort      Cohort @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  expertUser  User   @relation("ExpertUser", fields: [expert_user_id], references: [id])
  assignedBy  User   @relation("AssignedBy", fields: [assigned_by], references: [id])

  @@unique([cohort_id, expert_user_id, role])
  @@index([cohort_id])
  @@index([expert_user_id])
  @@map("cohort_experts")
}

// ===========================
// CORE — Evaluations (Jury)
// ===========================
model Evaluation {
  id            String          @id @default(uuid())
  project_id    String
  jury_user_id  String
  score         Float?
  comment       String?
  recommendation String?
  status        EvaluationStatus @default(DRAFT)
  submitted_at  DateTime?
  template_id   String?
  version       Int             @default(1)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  project   Project             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  juryUser  User                @relation(fields: [jury_user_id], references: [id])
  template  EvaluationTemplate? @relation(fields: [template_id], references: [id])
  scores    EvaluationScore[]

  @@unique([project_id, jury_user_id, template_id, version])
  @@index([project_id])
  @@index([jury_user_id])
  @@index([status])
  @@map("evaluations")
}

// ===========================
// CORE — Coachings
// ===========================
model Coaching {
  id            String   @id @default(uuid())
  project_id    String
  coach_user_id String
  feedback      String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  coachUser  User    @relation(fields: [coach_user_id], references: [id])

  @@unique([project_id, coach_user_id])
  @@index([project_id])
  @@index([coach_user_id])
  @@map("coachings")
}

// ===========================
// COACHING & ÉVALUATION — Affectations par projet
// ===========================
model ProjectExpertAssignment {
  id           String            @id @default(uuid())
  project_id   String
  expert_user_id String
  role         CohortExpertRole  @default(COACH)
  status       CohortExpertStatus @default(ACTIVE)
  assigned_by  String
  assigned_at  DateTime          @default(now())
  removed_at   DateTime?

  project     Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  expertUser  User               @relation("AssignmentExpert", fields: [expert_user_id], references: [id])
  assignedBy  User               @relation("AssignmentAssignedBy", fields: [assigned_by], references: [id])
  sessions    CoachingSession[]
  actions     CoachingAction[]

  @@unique([project_id, expert_user_id, role])
  @@index([project_id])
  @@index([expert_user_id])
  @@index([status])
  @@map("project_expert_assignments")
}

// ===========================
// COACHING & ÉVALUATION — Sessions
// ===========================
model CoachingSession {
  id               String                @id @default(uuid())
  assignment_id    String
  title            String?
  scheduled_at     DateTime
  duration_minutes Int?
  status           CoachingSessionStatus @default(SCHEDULED)
  report           String?
  created_by       String
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  completed_at     DateTime?

  assignment ProjectExpertAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("SessionCreatedBy", fields: [created_by], references: [id])
  actions    CoachingAction[]
  comments   CoachingComment[]
  recommendations CoachingRecommendation[]

  @@index([assignment_id])
  @@index([status])
  @@map("coaching_sessions")
}

// ===========================
// COACHING & ÉVALUATION — Recommandations
// ===========================
model CoachingRecommendation {
  id          String                      @id @default(uuid())
  session_id  String?
  project_id  String?
  author_id   String
  title       String?
  content     String
  priority    CoachingActionPriority      @default(MEDIUM)
  status      CoachingRecommendationStatus @default(OPEN)
  created_at  DateTime                    @default(now())
  updated_at  DateTime                    @updatedAt

  session CoachingSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)
  project Project?         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author  User             @relation("RecommendationAuthor", fields: [author_id], references: [id])
  actions CoachingAction[]

  @@index([session_id])
  @@index([project_id])
  @@map("coaching_recommendations")
}

// ===========================
// COACHING & ÉVALUATION — Actions
// ===========================
model CoachingAction {
  id                  String                @id @default(uuid())
  project_id          String
  session_id          String?
  assignment_id       String?
  recommendation_id   String?
  title               String
  description         String?
  status              CoachingActionStatus  @default(PENDING)
  priority            CoachingActionPriority @default(MEDIUM)
  deadline            DateTime?
  completed_at        DateTime?
  created_by          String
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  deadline_reminded_at DateTime?
  overdue_reminded_at  DateTime?

  project       Project                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  session       CoachingSession?       @relation(fields: [session_id], references: [id])
  assignment    ProjectExpertAssignment? @relation(fields: [assignment_id], references: [id])
  recommendation CoachingRecommendation? @relation(fields: [recommendation_id], references: [id])
  createdBy     User                   @relation("ActionCreatedBy", fields: [created_by], references: [id])
  comments      CoachingComment[]

  @@index([project_id])
  @@index([session_id])
  @@index([assignment_id])
  @@index([status])
  @@index([deadline])
  @@map("coaching_actions")
}

// ===========================
// COACHING & ÉVALUATION — Commentaires
// ===========================
model CoachingComment {
  id            String        @id @default(uuid())
  action_id     String?
  session_id    String?
  author_id     String
  content       String
  resource_type ResourceType?
  resource_id   String?
  created_at    DateTime      @default(now())

  action  CoachingAction?  @relation(fields: [action_id], references: [id], onDelete: Cascade)
  session CoachingSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)
  author  User             @relation("CommentAuthor", fields: [author_id], references: [id])

  @@index([action_id])
  @@index([session_id])
  @@index([resource_type, resource_id])
  @@map("coaching_comments")
}

// ===========================
// COACHING & ÉVALUATION — Grilles d'évaluation
// ===========================
model EvaluationTemplate {
  id          String          @id @default(uuid())
  cohort_id   String
  name        String
  description String?
  stage       EvaluationStage @default(FINAL)
  published   Boolean         @default(false)
  locked_at   DateTime?
  created_by  String
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  cohort     Cohort             @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  createdBy  User               @relation("TemplateCreatedBy", fields: [created_by], references: [id])
  criteria   EvaluationCriterion[]
  evaluations Evaluation[]

  @@index([cohort_id])
  @@map("evaluation_templates")
}

model EvaluationCriterion {
  id          String  @id @default(uuid())
  template_id String
  name        String
  description String?
  weight      Float   @default(1)
  max_score   Int     @default(5)
  sort_order  Int     @default(0)

  template EvaluationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  scores   EvaluationScore[]

  @@index([template_id])
  @@map("evaluation_criteria")
}

model EvaluationScore {
  id           String  @id @default(uuid())
  evaluation_id String
  criterion_id String
  score        Int
  comment      String?

  evaluation Evaluation        @relation(fields: [evaluation_id], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion @relation(fields: [criterion_id], references: [id], onDelete: Cascade)

  @@unique([evaluation_id, criterion_id])
  @@index([evaluation_id])
  @@map("evaluation_scores")
}

model EvaluationAssignment {
  id               String    @id @default(uuid())
  cohort_id        String
  project_id       String
  jury_user_id     String
  assigned_by      String
  created_at       DateTime  @default(now())
  deadline         DateTime?
  deadline_reminded_at DateTime?

  cohort     Cohort @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  juryUser   User   @relation("EvaluationJury", fields: [jury_user_id], references: [id])
  assignedBy User   @relation("EvaluationAssignedBy", fields: [assigned_by], references: [id])

  @@unique([cohort_id, project_id, jury_user_id])
  @@index([cohort_id])
  @@index([project_id])
  @@index([jury_user_id])
  @@index([deadline])
  @@map("evaluation_assignments")
}

// ===========================
// COACHING & ÉVALUATION — Décision finale & Conditions
// ===========================
model FinalDecision {
  id          String           @id @default(uuid())
  project_id  String
  cohort_id   String
  decision    FinalDecisionType
  final_score Float?
  justification String?
  new_end_date DateTime?
  decided_by  String
  decided_at  DateTime         @default(now())
  created_at  DateTime         @default(now())

  project Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  cohort  Cohort                @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  decidedBy User                @relation("DecisionDecidedBy", fields: [decided_by], references: [id])
  conditions FinalDecisionCondition[]

  @@index([project_id])
  @@index([cohort_id])
  @@map("final_decisions")
}

model FinalDecisionCondition {
  id           String         @id @default(uuid())
  decision_id  String
  description  String
  deadline     DateTime?
  status       ConditionStatus @default(PENDING)
  validated_by String?
  validated_at DateTime?
  created_at   DateTime       @default(now())

  decision    FinalDecision @relation(fields: [decision_id], references: [id], onDelete: Cascade)
  validatedBy User?         @relation("ConditionValidatedBy", fields: [validated_by], references: [id])

  @@index([decision_id])
  @@map("final_decision_conditions")
}

// ===========================
// COACHING & ÉVALUATION — Jury / Délibération
