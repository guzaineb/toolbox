// ===========================
model NotificationPreference {
  id                String   @id @default(uuid())
  user_id           String   @unique
  in_app_enabled    Boolean  @default(true)                  // notifications in-app
  email_enabled     Boolean  @default(true)                  // notifications par email
  realtime_enabled  Boolean  @default(true)                  // notifications temps réel (WebSocket)

  // Catégories activables/désactivables individuellement
  coaching_enabled  Boolean  @default(true)
  evaluation_enabled Boolean @default(true)
  cohort_enabled    Boolean  @default(true)
  invitation_enabled Boolean @default(true)
  document_enabled  Boolean  @default(true)
  ai_enabled        Boolean  @default(true)
  admin_enabled     Boolean  @default(true)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("notification_preferences")
}
