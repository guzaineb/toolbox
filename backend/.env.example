# ==================== BASE DE DONNÉES ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=db-toolbox
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/db-toolbox?schema=public

# ==================== JWT ====================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# ==================== EMAIL (SMTP) ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=ProjectStruct <noreply@toolbox.com>
MAIL_SECURE=false
FRONTEND_URL=http://localhost:3001

# ==================== IA / GROQ ====================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ==================== EMBEDDINGS / CHROMA ====================
EMBEDDINGS_API_URL=http://localhost:7860/v1/embeddings
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=project_summaries
