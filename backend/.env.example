# ==================== SERVEUR ====================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Nombre de requêtes/minute/IP (30 = défaut NestJS, trop bas en usage réel)
RATE_LIMIT_PER_MINUTE=600
# Origines CORS autorisées, séparées par des virgules (vide = toutes)
# 3001 = port du frontend en développement (`next dev -p 3001`)
CORS_ORIGINS=http://localhost:3001
# Dossier des fichiers téléversés
UPLOADS_DIR=uploads

# ==================== BASE DE DONNÉES ====================
# Valeurs alignées sur le conteneur de développement documenté dans le README :
#   docker run -d --name toolbox-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=admin -e POSTGRES_DB=db-toolbox postgres:15-alpine
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=db-toolbox
# En développement local, renseignez DATABASE_URL directement.
# En Docker, DATABASE_URL est construit par docker-compose.yml à partir de
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME : ne pas la définir ici.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/db-toolbox?schema=public

# ==================== JWT ====================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# ==================== EMAIL (SMTP) ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=ProjectStruct <noreply@toolbox.com>
MAIL_SECURE=false
FRONTEND_URL=http://localhost:3001

# ==================== IA / GROQ ====================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ==================== EMBEDDINGS / RAG ====================
# local = @xenova/transformers embarqué (384 dims, aucun service externe)
# api   = endpoint compatible OpenAI (EMBEDDINGS_API_URL)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDINGS_API_URL=
# ChromaDB est facultatif : sans CHROMA_URL, un client mock est utilisé et la
# recherche sémantique est indisponible (les autres fonctions IA restent OK).
CHROMA_URL=
CHROMA_COLLECTION=project_summaries
RAG_DISTANCE_THRESHOLD=0.4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
